# Copy this file to .env and replace every value. Do not commit .env.
# Placeholders below are not real credentials.

# Database (REQUIRED - PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@host:5432/supplypulse"

# Redis (REQUIRED for worker/queue)
REDIS_URL="redis://default:password@host:6379"

# Authentication (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Perplexity AI (needed for report generation and escalation summaries)
PERPLEXITY_API_KEY="your-perplexity-api-key"

# TypeSafe JEV classifier (worker only). Daily news is still collected if this is empty;
# items stay unclassified and no mid-week alert is sent.
# https://api.typesafe.ai/v1/systemone  model: jev-latest
JEV_API_KEY=""
# Skip AI supplier profile validation on create/update (local dev only)
# SUPPLIER_VALIDATION_SKIP="true"

# Resend (needed for email delivery)
# Add and verify your domain (e.g. supplypulse.net) in Resend dashboard, then add the DNS records they provide.
RESEND_API_KEY="your-resend-api-key"
# From address (optional). Default is "Supply Pulse <reports@supplypulse.net>". Use this to override.
# EMAIL_FROM="Supply Pulse <reports@supplypulse.net>"

# Polar (needed for payments)
POLAR_API_KEY="your-polar-access-token"
POLAR_WEBHOOK_SECRET="your-polar-webhook-secret"
POLAR_STANDARD_PRICE_ID="your-standard-price-id"
POLAR_PLUS_PRICE_ID="your-plus-price-id"
POLAR_PREMIUM_PRICE_ID="your-premium-price-id"

# Cloudflare Turnstile CAPTCHA (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# Server-only bootstrap for User.isAdmin. Not an authorization check.
# Set this on the Railway worker before deploy so the existing admin is not locked out.
# Optional on Vercel: a Node process grants the same user once the column exists.
# Remove NEXT_PUBLIC_ADMIN_EMAIL if it was set. See docs/ADMIN_ACCESS.md.
ADMIN_EMAIL="your-admin@example.com"

# Application URL (MUST match your Vercel deployment URL)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Meta (Facebook) Pixel — optional public site ID. Leave unset in local development.
# NEXT_PUBLIC_META_PIXEL_ID="your-meta-pixel-id"
