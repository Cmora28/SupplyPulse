# Database (REQUIRED - PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@host:5432/supplypulse"

# Redis (REQUIRED for worker/queue)
REDIS_URL="redis://default:password@host:6379"

# Authentication (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Perplexity AI (needed for report generation)
PERPLEXITY_API_KEY="pplx-..."

# Resend (needed for email delivery)
# Add and verify your domain (e.g. supplypulse.net) in Resend dashboard, then add the DNS records they provide.
RESEND_API_KEY="re_..."
# From address (optional). Default is "Supply Pulse <reports@supplypulse.net>". Use this to override.
# EMAIL_FROM="Supply Pulse <reports@supplypulse.net>"

# Polar (needed for payments)
POLAR_API_KEY="polar_oat_..."
POLAR_WEBHOOK_SECRET="polar_whs_..."
POLAR_STANDARD_PRICE_ID="your-standard-price-id"
POLAR_PREMIUM_PRICE_ID="your-premium-price-id"

# Admin email (for admin panel access)
ADMIN_EMAIL="your-admin@example.com"

# Application URL (MUST match your Vercel deployment URL)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
