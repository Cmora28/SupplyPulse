generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  STANDARD
  PLUS
  PREMIUM
  ENTERPRISE
}

enum ReportRunStatus {
  PENDING
  PROCESSING
  READY
  EMAILED
  FAILED
}

enum RunItemStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  REGISTER
  SUPPLIER_CREATE
  SUPPLIER_UPDATE
  SUPPLIER_DELETE
  SUPPLIER_VALIDATION_REJECTED
  REPORT_TRIGGER_MANUAL
  REPORT_TRIGGER_SCHEDULED
  REPORT_TRIGGER_ADMIN
  REPORT_DELETE
  REPORT_FINALIZED
  REPORT_EMAIL_SENT
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  PASSWORD_CHANGE
  PROFILE_UPDATE
  LOCALE_CHANGE
  NOTIFICATIONS_UPDATE
  REPORT_SCHEDULE_SET
  ACCOUNT_DELETE
  SUBSCRIPTION_TIER_CHANGED
  ADMIN_RESEND_REPORT_EMAIL
  SUPPORT_SUBMIT
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  password            String
  name                String
  subscriptionTier    SubscriptionTier @default(FREE)
  polarCustomerId     String?
  polarSubscriptionId String?
  locale              String           @default("en")
  reportDay           Int              @default(1)    // 0=Sun, 1=Mon, ..., 6=Sat
  reportHour          Int              @default(8)    // 0-23 UTC
  nextReportAt        DateTime?                       // Pre-calculated next run time
  emailNotifications  Boolean          @default(true)
  resetToken          String?          @unique
  resetTokenExpiry    DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  suppliers           Supplier[]
  reportRuns          ReportRun[]

  // Scheduler queries WHERE nextReportAt <= now every 15 min
  @@index([nextReportAt])
  // Polar webhook lookups by customer/subscription ID
  @@index([polarCustomerId])
  @@index([polarSubscriptionId])
}

model Supplier {
  id             String           @id @default(cuid())
  userId         String
  name           String
  country        String
  category       String
  leadTimeDays   Int
  cogsPercentage Float
  shippingRoute  String?
  dependencies   String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports        SupplierReport[]
  reportRunItems ReportRunItem[]

  @@index([userId])
}

model SupplierReport {
  id          String   @id @default(cuid())
  supplierId  String
  content     String   @db.Text
  citations   String[]
  weekOf      DateTime
  generatedAt DateTime @default(now())
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, weekOf])
  @@index([supplierId])
}

model ReportRun {
  id        String          @id @default(cuid())
  userId    String
  weekOf    DateTime
  status    ReportRunStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ReportRunItem[]

  // Dashboard: count this month + find latest run (covers both range filter and ordering)
  @@index([userId, createdAt])
  // Crash recovery: find stuck runs by status
  @@index([status])
}

model ReportRunItem {
  id            String        @id @default(cuid())
  reportRunId   String
  supplierId    String
  status        RunItemStatus @default(PENDING)
  startedAt     DateTime?
  finishedAt    DateTime?
  error         String?       @db.Text
  includedInPdf Boolean       @default(false)
  reportRun     ReportRun     @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Finalizer: count remaining items by run + status (hot path)
  @@index([reportRunId, status])
  @@index([supplierId])
}

model AuditEvent {
  id          String      @id @default(cuid())
  action      AuditAction
  success     Boolean     @default(true)
  actorUserId String?
  actorEmail  String?
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?     @db.VarChar(512)
  createdAt   DateTime    @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([actorEmail, createdAt(sort: Desc)])
  @@index([success, createdAt(sort: Desc)])
}
