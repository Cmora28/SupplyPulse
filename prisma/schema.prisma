generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  STANDARD
  PLUS
  PREMIUM
  ENTERPRISE
}

enum ReportRunStatus {
  PENDING
  PROCESSING
  READY
  EMAILED
  FAILED
}

enum RunItemStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  REGISTER
  SUPPLIER_CREATE
  SUPPLIER_UPDATE
  SUPPLIER_DELETE
  SUPPLIER_VALIDATION_REJECTED
  REPORT_TRIGGER_MANUAL
  REPORT_TRIGGER_SCHEDULED
  REPORT_TRIGGER_ADMIN
  REPORT_DELETE
  REPORT_FINALIZED
  REPORT_EMAIL_SENT
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  PASSWORD_CHANGE
  PROFILE_UPDATE
  LOCALE_CHANGE
  NOTIFICATIONS_UPDATE
  REPORT_SCHEDULE_SET
  ACCOUNT_DELETE
  SUBSCRIPTION_TIER_CHANGED
  ADMIN_RESEND_REPORT_EMAIL
  SUPPORT_SUBMIT
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  password            String
  name                String
  subscriptionTier    SubscriptionTier @default(FREE)
  polarCustomerId     String?
  polarSubscriptionId String?
  locale              String           @default("en")
  reportDay           Int              @default(1)    // 0=Sun, 1=Mon, ..., 6=Sat
  reportHour          Int              @default(8)    // 0-23 UTC
  nextReportAt        DateTime?                       // Pre-calculated next run time
  emailNotifications  Boolean          @default(true)
  // Server-side admin flag. Never trust email equality or a public env var.
  isAdmin             Boolean          @default(false)
  // Null on accounts created before terms acceptance was recorded.
  termsAcceptedAt     DateTime?
  termsVersion        String?
  resetToken          String?          @unique
  resetTokenExpiry    DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  suppliers           Supplier[]
  reportRuns          ReportRun[]

  // Scheduler queries WHERE nextReportAt <= now every 15 min
  @@index([nextReportAt])
  // Polar webhook lookups by customer/subscription ID
  @@index([polarCustomerId])
  @@index([polarSubscriptionId])
}

model Supplier {
  id             String           @id @default(cuid())
  userId         String
  name           String
  country        String
  category       String
  leadTimeDays   Int
  cogsPercentage Float
  shippingRoute  String?
  dependencies   String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports        SupplierReport[]
  reportRunItems ReportRunItem[]
  alerts         SupplierAlert[]

  @@index([userId])
}

model SupplierReport {
  id          String   @id @default(cuid())
  supplierId  String
  content     String   @db.Text
  citations   String[]
  weekOf      DateTime
  generatedAt DateTime @default(now())
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, weekOf])
  @@index([supplierId])
}

model ReportRun {
  id        String          @id @default(cuid())
  userId    String
  weekOf    DateTime
  status    ReportRunStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ReportRunItem[]

  // Dashboard: count this month + find latest run (covers both range filter and ordering)
  @@index([userId, createdAt])
  // Crash recovery: find stuck runs by status
  @@index([status])
}

model ReportRunItem {
  id            String        @id @default(cuid())
  reportRunId   String
  supplierId    String
  status        RunItemStatus @default(PENDING)
  startedAt     DateTime?
  finishedAt    DateTime?
  error         String?       @db.Text
  includedInPdf Boolean       @default(false)
  reportRun     ReportRun     @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Finalizer: count remaining items by run + status (hot path)
  @@index([reportRunId, status])
  @@index([supplierId])
}

// Shared news cache. supplierKey is a normalized name|country token, not a
// foreign key, so the same supplier is fetched and classified once for every
// customer. Rows with jevP >= 0.6 are kept; the daily job deletes older rows.
model NewsItem {
  id            String          @id @default(cuid())
  supplierKey   String
  urlHash       String          @db.Char(64)
  title         String
  url           String          @db.Text
  source        String?
  publishedAt   DateTime
  fetchedAt     DateTime        @default(now())
  raw           Json            @db.JsonB
  jevP          Float?
  promptVersion String?
  // JEV model id (jev-latest). Stored so a later prompt/model change can be
  // told apart from rows already scored.
  model         String?
  status        String          @default("new")
  // Daily run that inserted this row. Null for rows collected before the audit.
  runId         String?
  alerts        SupplierAlert[]
  jevCalls      JevCall[]
  run           NewsRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([supplierKey, urlHash])
  @@index([supplierKey, publishedAt(sort: Desc)])
  @@index([fetchedAt])
  @@index([jevP])
  @@index([runId])
  @@index([status, fetchedAt(sort: Desc)])
}

// Sent (or pending) disruption alerts. Not purged with NewsItem.
model SupplierAlert {
  id         String    @id @default(cuid())
  newsItemId String
  supplierId String
  severity      String
  summary       String    @db.Text
  // perplexity, fallback, or reused. Null on alerts created before the audit.
  summarySource String?
  summaryError  String?   @db.Text
  // pending, sent, or failed.
  emailStatus   String?
  emailError    String?   @db.Text
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  newsItem      NewsItem  @relation(fields: [newsItemId], references: [id], onDelete: Restrict)
  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([newsItemId, supplierId])
  @@index([supplierId])
  @@index([sentAt])
}

// One row per daily supplier-news job. Audit tables have their own 90-day
// retention. Deleting a run does not delete NewsItem (runId is SET NULL).
model NewsRun {
  id            String          @id @default(cuid())
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  status        String          @default("running")
  supplierKeys  Int             @default(0)
  fetched       Int             @default(0)
  keywordHits   Int             @default(0)
  inserted      Int             @default(0)
  skipped       Int             @default(0)
  classified    Int             @default(0)
  unclassified  Int             @default(0)
  alerts        Int             @default(0)
  emails        Int             @default(0)
  purged        Int             @default(0)
  errors        Json            @default("[]") @db.JsonB
  items         NewsItem[]
  jevCalls      JevCall[]
  candidates    NewsCandidate[]

  @@index([startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
}

// One row per JEV HTTP attempt. requestBody is the classifier payload only —
// the API key stays in the Authorization header and is never stored.
// newsItemId is SET NULL when the news row is purged so the delete can succeed.
model JevCall {
  id            String    @id @default(cuid())
  runId         String?
  newsItemId    String?
  requestBody   Json      @db.JsonB
  httpStatus    Int?
  ok            Boolean
  reason        String?
  message       String?   @db.Text
  p             Float?
  band          String?
  model         String?
  promptVersion String?
  latencyMs     Int?
  attempt       Int       @default(1)
  responseRaw   Json?     @db.JsonB
  createdAt     DateTime  @default(now())
  run           NewsRun?  @relation(fields: [runId], references: [id], onDelete: Cascade)
  newsItem      NewsItem? @relation(fields: [newsItemId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt(sort: Desc)])
  @@index([newsItemId, createdAt(sort: Desc)])
  @@index([createdAt])
}

// Fetched items that were not inserted. skipReason is one of
// no_keyword, cap, bad_url, dup_hash, dup_title.
model NewsCandidate {
  id          String    @id @default(cuid())
  runId       String?
  supplierKey String
  title       String
  url         String    @db.Text
  feed        String?
  source      String?
  publishedAt DateTime?
  skipReason  String
  createdAt   DateTime  @default(now())
  run         NewsRun?  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt(sort: Desc)])
  @@index([supplierKey, createdAt(sort: Desc)])
  @@index([skipReason, createdAt(sort: Desc)])
  @@index([createdAt])
}

model AuditEvent {
  id          String      @id @default(cuid())
  action      AuditAction
  success     Boolean     @default(true)
  actorUserId String?
  actorEmail  String?
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?     @db.VarChar(512)
  createdAt   DateTime    @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([actorEmail, createdAt(sort: Desc)])
  @@index([success, createdAt(sort: Desc)])
}
